---
import App from '../components/App'
import { I18N } from '../i18n'
import '../styles/global.css'

const title = 'Sunae ― 世界一シンプルなメモ帳を作れるサービス'
const description =
  'あなただけのメモ帳を作れます。ブラウザのブックマークに登録してクリック一つで即座に起動。気軽にメモして、閉じたら消える。'

// BASE_URL は末尾スラッシュの有無が設定に依存するため揃えておく
const rawBase = import.meta.env.BASE_URL
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(`${base}open-graph/index.png`, Astro.site)
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sunae" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={I18N.ja.ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@1,200&text=Sunae&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#fafaf9]">
    <App client:load />
  </body>
</html>
