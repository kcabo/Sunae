---
import Layout from '../layouts/Layout.astro'
import Counter from '../components/Counter'
---

<Layout title="Sunae">
  <main class="max-w-xl mx-auto px-6 py-24">
    <h1 class="text-3xl font-light tracking-tight mb-2">Sunae</h1>
    <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-16">
      A minimal starting point.
    </p>

    <section class="space-y-8">
      <div>
        <h2 class="text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-4">
          Interactive — SolidJS
        </h2>
        <Counter client:load />
      </div>

      <hr class="border-zinc-100 dark:border-zinc-800" />

      <div>
        <h2 class="text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-4">
          Stack
        </h2>
        <ul class="space-y-1 text-sm text-zinc-600 dark:text-zinc-400">
          <li>Astro 5</li>
          <li>SolidJS</li>
          <li>Tailwind CSS v4</li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
